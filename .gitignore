# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts

# production
build/
dist/

# testing
coverage/
test-results/
playwright-report/

# environment — everything .env* is secret except the committed template.
# Written as a sweep rather than a list because `.env.bak`, which `pnpm keys`
# now writes before it edits, matched none of the three patterns that were
# here, and this repository is public.
.env*
!.env.example

# misc
.DS_Store
*.pem
*.tsbuildinfo

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
# Shared workspace configuration IS committed: it is what makes the project
# behave the same in every contributor's editor. Personal files are not.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
