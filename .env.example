# =============================================================================
# MPS — environment template
# Copy to .env and fill in. NEVER commit .env or put real secrets in this file.
# =============================================================================

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Session signing secret. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Absolute URL the app is served from (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
