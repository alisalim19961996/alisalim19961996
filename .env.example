# =============================================================================
# MPS — environment template
# Copy to .env and fill in. NEVER commit .env or put real secrets in this file.
# =============================================================================

# PostgreSQL connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Session signing secret. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Absolute URL the app is served from (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Image upload (Supabase Storage). Optional — leave empty and the product form
# asks for a path under public/ instead, which is all a local machine needs.
#
# SUPABASE_SERVICE_ROLE_KEY IS A SECRET. It bypasses every row-level policy in
# the project. It is read server-side only, never with a NEXT_PUBLIC_ name, and
# never committed. If it ever leaks, rotate it in the Supabase dashboard.
#
# Where to find them:
#   Project Settings -> Data API  -> Project URL    => SUPABASE_URL
#   Project Settings -> API keys  -> service_role   => SUPABASE_SERVICE_ROLE_KEY
# -----------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# -----------------------------------------------------------------------------
# Mail — optional. Enables "forgot your password?".
# Without it the store sells normally; only password reset is unavailable,
# and the form says so instead of promising an email nobody sent.
# Key: resend.com -> API Keys.  MAIL_FROM needs a domain verified there.
RESEND_API_KEY=""
MAIL_FROM=""

# Google sign-in. Optional — leave empty and the sign-in page shows only the
# email + password form, with no Google button.
#
# Google Cloud console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#   -> Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
#      (exactly, including the scheme and port)
#
# GOOGLE_CLIENT_SECRET IS A SECRET. Server-side only, never committed.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Optional, development only. Read by `pnpm db:seed`, never by the app.
# Sets the password for the demo accounts (admin@mps.local, customer@mps.local).
# Leave it unset and the seed generates one and prints it once — there is
# nowhere safe to store it, and a dashboard nobody can open is not a dashboard.
# Minimum 8 characters.
# -----------------------------------------------------------------------------
# DEMO_ADMIN_PASSWORD=""
